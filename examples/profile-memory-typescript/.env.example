# --- LLM Provider Settings (OpenAI-compatible mode, note /v1 at the end for Ollama) ---
# Ollama Example:
LLM_MODEL=llama3.2
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama

# OpenAI Example:
# LLM_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...

# --- Helomi Settings ---
HELOMI_SERVER_URL=http://127.0.0.1:4356
# Leave empty to automatically listen to all loaded Helomi profiles, or specify one (e.g. default)
HELOMI_PROFILE_ID=

# --- Memory Settings ---
# Number of recent messages retained in context per profile (default: 10)
MAX_MEMORY_MESSAGES=10

# Helomi Server settings
HELOMI_SERVER_URL=http://127.0.0.1:4356
HELOMI_PROFILE_ID=default

# Translation and style settings
SOURCE_LANGUAGE=Polish
TARGET_LANGUAGE=English

# LLM Model
LLM_MODEL=gpt-4o-mini

# OpenAI configuration (standard OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama OpenAI-compatible configuration (note: /v1 at the end is required)
# LLM_MODEL=llama3.2
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
